{
  "name": "projectpulse-lite",
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "env": {
    "VITE_SUPABASE_URL": "@env/VITE_SUPABASE_URL",
    "VITE_SUPABASE_ANON_KEY": "@env/VITE_SUPABASE_ANON_KEY",
    "VITE_APP_MODE": "production"
  }
}